# Production settings for the KRGI Academic Audit System (read by backend/audit_backend/settings.py).
# Copy to the server's environment (systemd EnvironmentFile, hosting panel, etc.). Never commit the real file.
# Unset variables use the safe defaults noted here.

# Long random secret, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset, a random key is created once in backend/.secret_key (git-ignored).
AUDIT_SECRET_KEY=

# Debug pages show code and settings: keep false on the website (default false)
AUDIT_DEBUG=false

# The site's domain name(s), comma-separated (default: localhost,127.0.0.1)
AUDIT_ALLOWED_HOSTS=audit.example.ac.in

# Origins allowed to send logged-in POST requests (the site itself, with https://)
AUDIT_CSRF_TRUSTED_ORIGINS=https://audit.example.ac.in

# HTTPS: redirect http to https, secure cookies, HSTS. Turn on once the certificate works.
AUDIT_HTTPS=true
# Seconds browsers remember "HTTPS only". Start with 3600; raise to 31536000 after a week without problems.
AUDIT_HSTS_SECONDS=3600
AUDIT_HSTS_SUBDOMAINS=false
# true when nginx / a load balancer in front of Django handles HTTPS and sets X-Forwarded-Proto
AUDIT_BEHIND_PROXY=true

# Login session length in hours (also ends when the browser is closed)
AUDIT_SESSION_HOURS=8

# Failed-login lockout: failures per username (an address gets 5x) and lockout period
AUDIT_LOGIN_MAX_FAILURES=5
AUDIT_LOGIN_LOCKOUT_MINUTES=15

# Django Admin: off by default. If needed, use an unusual path and limit it to the office address(es).
AUDIT_ADMIN_ENABLED=false
# AUDIT_ADMIN_PATH=krgi-control-7f3a/
# AUDIT_ADMIN_ALLOWED_IPS=203.0.113.10

# Database: SQLite by default; PostgreSQL recommended for many simultaneous users (see README)
# AUDIT_DB_ENGINE=postgresql
# AUDIT_DB_NAME=krgi_audit
# AUDIT_DB_USER=krgi_audit
# AUDIT_DB_PASSWORD=
# AUDIT_DB_HOST=127.0.0.1
# AUDIT_DB_PORT=5432

# AI assistant (see ai_assistant.env.example). Ollama must stay on 127.0.0.1 / the private network.
# AUDIT_AI_ENABLED=true
# AUDIT_AI_MODEL=llama3.2:3b
