# AI Audit Assistant configuration (no secrets needed).
# These are environment variables read by backend/audit_backend/settings.py (AUDIT_AI).
# PowerShell: set them in the same terminal before "python manage.py runserver", e.g.
#   $env:AUDIT_AI_MODEL = "qwen3.5:9b"
# Unset variables use the defaults shown here.

# Turn the local-model features on/off (verified analytics and reports work either way)
AUDIT_AI_ENABLED=true

# Ollama server. Must be this machine or a private network address; never expose Ollama to the internet.
AUDIT_AI_OLLAMA_URL=http://127.0.0.1:11434

# Model installed in Ollama (check its licence first: ollama show <model> --license)
AUDIT_AI_MODEL=qwen3.5:9b

# Seconds to wait for Ollama to answer the status check / a generation
AUDIT_AI_CONNECT_TIMEOUT=3
AUDIT_AI_RESPONSE_TIMEOUT=300

# Context window and maximum output tokens per call (smaller = faster on CPU)
AUDIT_AI_NUM_CTX=4096
AUDIT_AI_NUM_PREDICT=350

# Model calls running at the same time (1 is right for a CPU-only laptop)
AUDIT_AI_MAX_CONCURRENCY=1

# How long Ollama keeps the model in memory after a call (e.g. 5m, 30s, 0 to unload at once)
AUDIT_AI_KEEP_ALIVE=5m

# Per-user limits
AUDIT_AI_CHAT_LIMIT_PER_MINUTE=6
AUDIT_AI_REPORT_LIMIT_PER_HOUR=10

# Where draft reports are stored (outside every served folder) and how long they are kept
AUDIT_AI_REPORT_DIR=E:\NBA_NV\backend\generated_reports
AUDIT_AI_REPORT_RETENTION_DAYS=30
